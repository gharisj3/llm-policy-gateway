# SQLAlchemy-style database URL. SQLite is suitable for local development.
DATABASE_URL=sqlite:///./gateway.db
# Random UTF-8 secret of at least 32 bytes used to hash gateway API keys.
KEY_PEPPER=replace-with-at-least-32-random-bytes
# Secret bearer token required by the future localhost admin API.
ADMIN_TOKEN=replace-with-a-long-random-secret
# Host and port for the future admin API; keep loopback for local access.
ADMIN_BIND=127.0.0.1:8081
# Permit a non-loopback admin bind only when explicitly set to true.
ADMIN_ALLOW_REMOTE=false
# Host and port for the public gateway API.
GATEWAY_BIND=127.0.0.1:8080
# Base URL for the local Ollama service.
OLLAMA_HOST=http://127.0.0.1:11434
# Azure OpenAI resource endpoint; required only for that adapter.
AZURE_OPENAI_ENDPOINT=
# Azure OpenAI API key; required only when key authentication is used.
AZURE_OPENAI_API_KEY=
# Azure deployment name used by the Azure adapter.
AZURE_OPENAI_DEPLOYMENT=
# Azure service API version used by the Azure adapter.
AZURE_OPENAI_API_VERSION=
# AWS region for the Bedrock adapter.
AWS_REGION=
# Bedrock model identifier used by the AWS adapter.
BEDROCK_MODEL_ID=
# OpenAI API key; required only for that adapter.
OPENAI_API_KEY=
# Store only post-redaction prompt text in audit records when true.
AUDIT_STORE_PROMPTS=false
# Path to the default tenant policy YAML file.
DEFAULT_POLICY_PATH=policy.yaml
# Path to the public model routing YAML file.
MODELS_PATH=models.yaml
# Maximum accepted public request body size in bytes.
MAX_REQUEST_BYTES=1048576
# Retry count after the first upstream attempt for retryable failures.
UPSTREAM_MAX_RETRIES=2
# Timeout in seconds for each provider attempt.
UPSTREAM_TIMEOUT_SECONDS=60
# Structured log verbosity.
LOG_LEVEL=INFO
# Language code used by the redaction analyzer.
PRESIDIO_LANGUAGE=en
